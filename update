#!/usr/bin/env bash
# Agentic Marketers Vault — one-line installer + updater.
# Usage (client pastes this):
#   curl -fsSL https://agentic-marketers.vercel.app/update | bash
#
# First run: connects the client to GitHub and clones their vault.
# Every run after: pulls the latest template, leaving their own data untouched.
# This script is PUBLIC and holds no secrets. The vault content is a PRIVATE
# repo; only clients granted read access can actually pull it.

set -euo pipefail

REPO="agentic-marketers/vault-template"
REPO_URL="https://github.com/${REPO}.git"
VAULT_DIR="${AM_VAULT_DIR:-$HOME/AgenticMarketersVault}"
TTY=/dev/tty

say()  { printf "\033[1;34m[vault]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[vault]\033[0m %s\n" "$*"; }
die()  { printf "\033[1;31m[vault]\033[0m %s\n" "$*" >&2; exit 1; }

# --- 1. prerequisites -------------------------------------------------------
need() { command -v "$1" >/dev/null 2>&1; }

if ! need git; then
  die "git is not installed. Install it, then re-run:
       macOS:  xcode-select --install    (or: brew install git)
       then paste the same command again."
fi

if ! need gh; then
  die "GitHub CLI (gh) is not installed. Install it, then re-run:
       macOS:  brew install gh
       Windows/Linux: https://github.com/cli/cli#installation
       then paste the same command again."
fi

# --- 2. connect to GitHub (first run only) ----------------------------------
if ! gh auth status --hostname github.com >/dev/null 2>&1; then
  say "Connecting you to GitHub (a browser window will open)..."
  if [ -r "$TTY" ]; then
    gh auth login --hostname github.com --git-protocol https --web < "$TTY" > "$TTY" 2>&1 \
      || die "GitHub sign-in did not complete. Re-run the command to try again."
  else
    die "Can't open an interactive login here. Run this once in your terminal:
         gh auth login
       then paste the update command again."
  fi
fi
# make plain git use the gh login (so private clone/pull needs no password)
gh auth setup-git --hostname github.com >/dev/null 2>&1 || true

# --- 3. confirm access to the private vault ---------------------------------
if ! gh repo view "$REPO" >/dev/null 2>&1; then
  die "Your GitHub account does not have access to the vault yet.
       Ask your Agentic Marketers contact to add you, then re-run this command."
fi

# --- 4. install (first run) or update (every run after) ---------------------
if [ -f "$VAULT_DIR/AGENTS.md" ] && [ -d "$VAULT_DIR/Adapters" ]; then
  say "Updating your vault at $VAULT_DIR ..."
  if [ -f "$VAULT_DIR/Scripts/install/update-vault.sh" ]; then
    ( cd "$VAULT_DIR" && bash Scripts/install/update-vault.sh )
  else
    die "Vault found but its updater is missing. Contact support."
  fi
  say "Up to date. Your clients, .env, and MyBusiness were left untouched."
elif [ -e "$VAULT_DIR" ] && [ -n "$(ls -A "$VAULT_DIR" 2>/dev/null)" ]; then
  die "$VAULT_DIR already exists and is not a vault.
       Move or rename it, or set a different folder:
       AM_VAULT_DIR=\"\$HOME/MyVault\" then re-run."
else
  say "Setting up your vault in $VAULT_DIR ..."
  git clone "$REPO_URL" "$VAULT_DIR" \
    || die "Clone failed. Confirm you accepted the GitHub invite, then re-run."
  ( cd "$VAULT_DIR" && [ -x Scripts/hooks/install-hooks.sh ] && bash Scripts/hooks/install-hooks.sh >/dev/null 2>&1 || true )
  say "Done. Your vault is ready at $VAULT_DIR"
  say "Open that folder in Claude Code to start. Run this same command anytime to update."
fi
